# ─── FitnessGuruSG Mobile — Environment Variables Example ──────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored. This file IS committed as documentation.

# ─── DEV: Your Mac's current LAN IP ─────────────────────────────────────────
# Find it with: ipconfig getifaddr en0
# iOS Simulator Dev Builds CANNOT use "localhost" — it resolves to the device itself.
EXPO_PUBLIC_API_URL=http://192.168.X.X:5001

# ─── PROD: Your deployed backend URL ─────────────────────────────────────────
EXPO_PUBLIC_API_URL_PROD=https://api.fitnessgurusg.com
