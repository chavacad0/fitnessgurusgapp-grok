# Environment Variables Template

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017
DB_NAME=fitnessgurusg

# Tests only (npm test). Never point these at the database named in DB_NAME.
# npm test refuses to run unless NODE_ENV is test (the npm script sets that)
# and the database name ends with _test. Leave TEST_DB_NAME unset to use fitnessgurusg_test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
TEST_DB_NAME=fitnessgurusg_test

# Application
NODE_ENV=development
PORT=5001

# Security (generate using: openssl rand -base64 32)
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Admin secret — required for POST /api/auth/register (coach account creation)
# Only Postman / seed scripts with this header can create coach accounts.
# Mobile app clients CANNOT use this endpoint — it always returns 403 without this header.
# Generate using: openssl rand -base64 32
ADMIN_SECRET=your_admin_secret_here

# CORS — comma-separated list of allowed origins
# Development default: http://localhost:8081 (Expo dev server)
# Production: set to your deployed frontend URL
CORS_ORIGIN=http://localhost:8081

# Logging
LOG_LEVEL=debug

# Google OAuth (required for "Continue with Google" feature)
# Step 1: Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# Step 2: Create OAuth 2.0 Client ID → Web application
# Step 3: Copy the "Web Client ID" value here
# Step 4: Also create iOS and Android client IDs for mobile (different IDs)
# The Web Client ID is what the backend uses to verify ID tokens.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Sending is OFF unless WHATSAPP_ENABLED is exactly true. Leave it false.
# The route then answers "not available yet" and does not send a message.
# Do not put a real token here.
WHATSAPP_ENABLED=false
# From Meta Developer Dashboard → WhatsApp → API Setup
# ⚠️  NEVER commit real values here. These MUST be rotated before any deployment.
# ⚠️  Rotate the WHATSAPP_ACCESS_TOKEN at Meta Dashboard before going live.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
