## Phase 3: Core API Endpoints

### 3.1: Authentication

#### `POST /api/auth/login`

**Request:**
```json
{
  "email": "client@test.sg",
  "password": "password123"
}
```

**Response (Success):**
```json
{
  "success": true,
  "user": {
    "id": "uuid",
    "email": "client@test.sg",
    "name": "Alice Tan",
    "role": "client"
  },
  "client": {
    "id": "uuid",
    "subscription_status": "active",
    "paid_until": "2026-03-06",
    "onboarding_complete": true
  },
  "access_token": "jwt_token_here"
}
```

**Response (Overdue - within grace):**
```json
{
  "success": true,
  "warning": "payment_overdue",
  "message": "Your payment is overdue. Please contact your coach.",
  "days_overdue": 3,
  "user": { ... },
  "access_token": "jwt_token_here"
}
```

**Response (Locked - beyond grace):**
```json
{
  "success": false,
  "error": "access_expired",
  "message": "Your access has expired. Please contact your coach to renew."
}
```

**Backend Logic:**
```javascript
// Pseudo-code
async function login(email, password) {
  const user = await findUserByEmail(email);
  if (!user || !verifyPassword(password, user.password_hash)) {
    return { success: false, error: 'invalid_credentials' };
  }

  if (user.role === 'client') {
    const client = await findClientByUserId(user.id);
    
    // Check access rules
    const gracePeriodEnd = addDays(client.paid_until, 7);
    const now = new Date();
    
    if (client.subscription_status === 'cancelled') {
      return { success: false, error: 'subscription_cancelled' };
    }
    
    if (!client.coach_override_access && now > gracePeriodEnd) {
      return { success: false, error: 'access_expired' };
    }
    
    const isOverdue = now > client.paid_until;
    const warning = isOverdue ? {
      warning: 'payment_overdue',
      days_overdue: Math.floor((now - client.paid_until) / 86400000)
    } : {};
    
    return {
      success: true,
      ...warning,
      user: sanitizeUser(user),
      client: sanitizeClient(client),
      access_token: generateJWT(user)
    };
  }
  
  // Coach login (simplified)
  return { success: true, user, access_token: generateJWT(user) };
}
```

