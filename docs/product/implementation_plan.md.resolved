### 3.2: Invitation Flow

#### `POST /api/invitations` (Coach only)

**Request:**
```json
{
  "email": "newclient@example.sg",
  "phone": "+6512345678",
  "initial_package_type": "gold"
}
```

**Response:**
```json
{
  "success": true,
  "invitation": {
    "id": "uuid",
    "email": "newclient@example.sg",
    "token": "abc123xyz",
    "invite_link": "https://app.fitnessprac.sg/join/abc123xyz",
    "expires_at": "2026-02-11T00:37:01+08:00"
  }
}
```

**Backend:**
```sql
INSERT INTO invitations (coach_id, email, phone, token, expires_at, status, initial_package_type)
VALUES (:coach_id, :email, :phone, gen_random_uuid(), NOW() + INTERVAL '7 days', 'pending', :package_type)
RETURNING *;
```

#### `POST /api/invitations/:token/accept`

**Request:**
```json
{
  "name": "Bob Lee",
  "password": "securepass123",
  "birthday": "1990-05-15",
  "consent_whatsapp": true,
  "consent_data_processing": true
}
```

**Response:**
```json
{
  "success": true,
  "message": "Account created successfully!",
  "user": {
    "id": "uuid",
    "email": "newclient@example.sg",
    "name": "Bob Lee"
  },
  "next_step": "onboarding"
}
```

**Backend Logic:**
```javascript
async function acceptInvitation(token, data) {
  // 1. Validate invitation
  const invitation = await db.query(
    'SELECT * FROM invitations WHERE token = $1 AND status = $2 AND expires_at > NOW()',
    [token, 'pending']
  );
  
  if (!invitation) {
    return { success: false, error: 'invalid_or_expired_token' };
  }
  
  // 2. Create user
  const hashedPassword = await bcrypt.hash(data.password, 12);
  const user = await db.query(
    `INSERT INTO users (email, phone, password_hash, role, name)
     VALUES ($1, $2, $3, 'client', $4) RETURNING *`,
    [invitation.email, invitation.phone, hashedPassword, data.name]
  );
  
  // 3. Create client
  const client = await db.query(
    `INSERT INTO clients (
      user_id, coach_id, status, subscription_status,
      subscription_start_date, paid_until, billing_cycle,
      start_date, birthday, consent_whatsapp, consent_data_processing,
      invited_by_coach_id
    ) VALUES ($1, $2, 'active', 'active', NOW(), NOW() + INTERVAL '30 days',
              'monthly', NOW(), $3, $4, $5, $6) RETURNING *`,
    [user.id, invitation.coach_id, data.birthday, data.consent_whatsapp,
     data.consent_data_processing, invitation.coach_id]
  );
  
  // 4. Mark invitation accepted
  await db.query(
    `UPDATE invitations SET status = 'accepted', accepted_at = NOW(), client_id = $1
     WHERE id = $2`,
    [client.id, invitation.id]
  );
  
  // 5. Create initial package if specified
  if (invitation.initial_package_type) {
    const packageConfig = PACKAGE_CONFIGS[invitation.initial_package_type];
    await createPackage(client.id, packageConfig);
  }
  
  return { success: true, user, client };
}
```

