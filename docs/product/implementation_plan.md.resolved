### 3.4: Session & Package Management

#### `POST /api/sessions` (Coach only)

**Request:**
```json
{
  "client_id": "uuid",
  "session_date": "2026-02-04T10:00:00+08:00",
  "duration_minutes": 60,
  "notes": "Focused on lower body strength"
}
```

**Response:**
```json
{
  "success": true,
  "session": {
    "id": "uuid",
    "client_id": "uuid",
    "package_id": "uuid",
    "session_date": "2026-02-04T10:00:00+08:00",
    "created_at": "2026-02-04T12:00:00+08:00"
  },
  "package_updated": {
    "id": "uuid",
    "used_sessions": 5,
    "total_sessions": 20,
    "remaining_sessions": 15
  }
}
```

**Backend Logic:**
```javascript
async function logSession(coachId, data) {
  // 1. Find active package
  const package = await db.query(
    `SELECT * FROM packages
     WHERE client_id = $1
       AND status = 'active'
       AND used_sessions < total_sessions
       AND expires_at >= CURRENT_DATE
     ORDER BY purchased_at ASC
     LIMIT 1`,
    [data.client_id]
  );
  
  if (!package) {
    return { success: false, error: 'no_active_package' };
  }
  
  // 2. Create session record
  const session = await db.query(
    `INSERT INTO sessions (client_id, package_id, coach_id, session_date, duration_minutes, notes)
     VALUES ($1, $2, $3, $4, $5, $6) RETURNING *`,
    [data.client_id, package.id, coachId, data.session_date, data.duration_minutes, data.notes]
  );
  
  // 3. Increment used_sessions
  const updatedPackage = await db.query(
    `UPDATE packages
     SET used_sessions = used_sessions + 1
     WHERE id = $1
     RETURNING *`,
    [package.id]
  );
  
  // 4. Mark as completed if all sessions used
  if (updatedPackage.used_sessions >= updatedPackage.total_sessions) {
    await db.query(`UPDATE packages SET status = 'completed' WHERE id = $1`, [package.id]);
  }
  
  return {
    success: true,
    session,
    package_updated: {
      id: updatedPackage.id,
      used_sessions: updatedPackage.used_sessions,
      total_sessions: updatedPackage.total_sessions,
      remaining_sessions: updatedPackage.total_sessions - updatedPackage.used_sessions
    }
  };
}
```

#### `POST /api/packages` (Coach only - assign new package)

**Request:**
```json
{
  "client_id": "uuid",
  "package_type": "gold",
  "payment_amount": 550.00,
  "payment_method": "paynow"
}
```

**Response:**
```json
{
  "success": true,
  "package": {
    "id": "uuid",
    "package_type": "gold",
    "total_sessions": 20,
    "duration_days": 60,
    "expires_at": "2026-04-05"
  },
  "payment": {
    "id": "uuid",
    "amount_sgd": 550.00,
    "status": "completed"
  }
}
```

**Backend:**
```javascript
async function assignPackage(coachId, data) {
  const packageConfig = {
    silver: { sessions: 10, days: 30, price: 300 },
    gold: { sessions: 20, days: 60, price: 550 },
    platinum: { sessions: 30, days: 90, price: 750 }
  }[data.package_type];
  
  // 1. Create package
  const package = await db.query(
    `INSERT INTO packages (
      client_id, package_type, total_sessions, duration_days,
      price_sgd, expires_at
    ) VALUES ($1, $2, $3, $4, $5, CURRENT_DATE + $4 * INTERVAL '1 day')
    RETURNING *`,
    [data.client_id, data.package_type, packageConfig.sessions,
     packageConfig.days, packageConfig.price]
  );
  
  // 2. Record payment
  const payment = await db.query(
    `INSERT INTO payments (
      client_id, package_id, amount_sgd, payment_method, status, paid_at
    ) VALUES ($1, $2, $3, $4, 'completed', NOW())
    RETURNING *`,
    [data.client_id, package.id, data.payment_amount, data.payment_method]
  );
  
  // 3. Extend paid_until
  await db.query(
    `UPDATE clients
     SET paid_until = GREATEST(paid_until, CURRENT_DATE) + $1 * INTERVAL '1 day',
         subscription_status = 'active',
         coach_override_access = false
     WHERE id = $2`,
    [packageConfig.days, data.client_id]
  );
  
  return { success: true, package, payment };
}
```

---

## Phase 4: Automated Jobs

### Job 4.1: Update Subscription Status (Daily)

**Runs:** Every day at 00:00 SGT

**Logic:**
```sql
-- Mark clients as past_due when paid_until expires
UPDATE clients
SET subscription_status = 'past_due',
    status = 'payment_overdue'
WHERE paid_until < CURRENT_DATE
  AND subscription_status = 'active'
  AND coach_override_access = false;

-- Expire old packages
UPDATE packages
SET status = 'expired'
WHERE expires_at < CURRENT_DATE
  AND status = 'active';
```

### Job 4.2: Send Payment Reminders (Daily)

**Runs:** Every day at 09:00 SGT

**Logic:**
```javascript
// Send reminder 7 days before expiry
const clientsDue = await db.query(`
  SELECT c.id, u.name, u.phone, c.paid_until
  FROM clients c
  JOIN users u ON u.id = c.user_id
  WHERE c.paid_until = CURRENT_DATE + INTERVAL '7 days'
    AND c.subscription_status = 'active'
`);

for (const client of clientsDue) {
  await sendWhatsAppMessage(client.phone, 
    `Hi ${client.name}, your subscription renews in 7 days (${client.paid_until}). ` +
    `Please contact me to arrange payment. - Coach`
  );
}
```

