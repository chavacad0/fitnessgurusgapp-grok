# Implementation Plan – Fitness Coaching App MVP

> [!IMPORTANT]
> This plan covers database setup, seeding, API contracts, and core feature implementation in priority order.

---

## Phase 1: Database Setup

### Step 1.1: Create Core Tables

**Priority order (dependencies first):**

```sql
-- 1. Users (auth foundation)
CREATE TABLE users (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  email VARCHAR(255) UNIQUE NOT NULL,
  phone VARCHAR(20) UNIQUE NOT NULL,
  password_hash VARCHAR(255) NOT NULL,
  role VARCHAR(20) NOT NULL CHECK (role IN ('coach', 'client')),
  name VARCHAR(255) NOT NULL,
  avatar_url TEXT,
  timezone VARCHAR(50) NOT NULL DEFAULT 'Asia/Singapore',
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_phone ON users(phone);
CREATE INDEX idx_users_role ON users(role);

-- 2. Coaches
CREATE TABLE coaches (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID UNIQUE NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  business_name VARCHAR(255),
  whatsapp_number VARCHAR(20) NOT NULL,
  stripe_account_id VARCHAR(255),
  onboarding_complete BOOLEAN NOT NULL DEFAULT false,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

-- 3. Clients (with subscription tracking)
CREATE TABLE clients (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID UNIQUE NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  coach_id UUID NOT NULL REFERENCES coaches(id),
  status VARCHAR(20) NOT NULL CHECK (status IN ('active', 'paused', 'inactive', 'payment_overdue')),
  subscription_status VARCHAR(20) NOT NULL CHECK (subscription_status IN ('trial', 'active', 'past_due', 'cancelled')),
  subscription_start_date DATE NOT NULL,
  subscription_end_date DATE,
  paid_until DATE NOT NULL,
  billing_cycle VARCHAR(20) NOT NULL CHECK (billing_cycle IN ('weekly', 'monthly', 'quarterly', 'one_time')),
  monthly_fee_sgd DECIMAL(10, 2),
  start_date DATE NOT NULL,
  target_weight_kg DECIMAL(5, 2),
  target_waist_cm DECIMAL(5, 2),
  daily_step_goal INTEGER,
  birthday DATE,
  consent_whatsapp BOOLEAN NOT NULL,
  consent_data_processing BOOLEAN NOT NULL,
  onboarding_complete BOOLEAN NOT NULL DEFAULT false,
  invited_by_coach_id UUID NOT NULL REFERENCES coaches(id),
  coach_override_access BOOLEAN NOT NULL DEFAULT false,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_clients_coach_status ON clients(coach_id, status);
CREATE INDEX idx_clients_coach_subscription ON clients(coach_id, subscription_status);
CREATE INDEX idx_clients_paid_until ON clients(paid_until);

-- 4. Invitations
CREATE TABLE invitations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  coach_id UUID NOT NULL REFERENCES coaches(id),
  email VARCHAR(255) NOT NULL,
  phone VARCHAR(20),
  token VARCHAR(255) UNIQUE NOT NULL,
  status VARCHAR(20) NOT NULL CHECK (status IN ('pending', 'accepted', 'expired')),
  expires_at TIMESTAMP NOT NULL,
  accepted_at TIMESTAMP,
  client_id UUID REFERENCES clients(id),
  initial_package_type VARCHAR(20),
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE UNIQUE INDEX idx_invitations_token ON invitations(token);
CREATE INDEX idx_invitations_coach_status ON invitations(coach_id, status);
CREATE INDEX idx_invitations_email ON invitations(email);

-- 5. Check-ins
CREATE TABLE check_ins (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  client_id UUID NOT NULL REFERENCES clients(id) ON DELETE CASCADE,
  date DATE NOT NULL,
  steps INTEGER NOT NULL,
  hunger_level INTEGER NOT NULL CHECK (hunger_level BETWEEN 1 AND 10),
  energy_level INTEGER NOT NULL CHECK (energy_level BETWEEN 1 AND 10),
  weight_kg DECIMAL(5, 2),
  waist_cm DECIMAL(5, 2),
  meal_photo_url TEXT,
  notes TEXT,
  submitted_at TIMESTAMP NOT NULL DEFAULT NOW(),
  reviewed_by_coach BOOLEAN NOT NULL DEFAULT false,
  reviewed_at TIMESTAMP,
  coach_notes TEXT,
  has_red_flag BOOLEAN NOT NULL DEFAULT false,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  UNIQUE(client_id, date)
);

CREATE INDEX idx_checkins_review_queue ON check_ins(client_id, reviewed_by_coach, date DESC);
CREATE INDEX idx_checkins_red_flags ON check_ins(client_id, has_red_flag, date DESC);

-- 6. Packages (with updated fields)
CREATE TABLE packages (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  client_id UUID NOT NULL REFERENCES clients(id) ON DELETE CASCADE,
  package_type VARCHAR(20) NOT NULL CHECK (package_type IN ('silver', 'gold', 'platinum', 'custom')),
  total_sessions INTEGER NOT NULL,
  used_sessions INTEGER NOT NULL DEFAULT 0,
  duration_days INTEGER NOT NULL,
  price_sgd DECIMAL(10, 2) NOT NULL,
  purchased_at TIMESTAMP NOT NULL DEFAULT NOW(),
  expires_at DATE NOT NULL,
  status VARCHAR(20) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'expired', 'completed')),
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_packages_client_status ON packages(client_id, status);
CREATE INDEX idx_packages_expires_at ON packages(expires_at);

-- 7. Sessions
CREATE TABLE sessions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  client_id UUID NOT NULL REFERENCES clients(id) ON DELETE CASCADE,
  package_id UUID NOT NULL REFERENCES packages(id),
  coach_id UUID NOT NULL REFERENCES coaches(id),
  session_date TIMESTAMP NOT NULL,
  duration_minutes INTEGER,
  notes TEXT,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_sessions_client_date ON sessions(client_id, session_date DESC);
CREATE INDEX idx_sessions_package ON sessions(package_id);

-- 8. Payments
CREATE TABLE payments (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  client_id UUID NOT NULL REFERENCES clients(id) ON DELETE CASCADE,
  package_id UUID REFERENCES packages(id),
  amount_sgd DECIMAL(10, 2) NOT NULL,
  currency VARCHAR(3) NOT NULL DEFAULT 'SGD',
  payment_method VARCHAR(20) NOT NULL CHECK (payment_method IN ('stripe', 'paynow', 'cash', 'bank_transfer')),
  stripe_payment_intent_id VARCHAR(255),
  status VARCHAR(20) NOT NULL CHECK (status IN ('pending', 'completed', 'failed', 'refunded')),
  paid_at TIMESTAMP,
  notes TEXT,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_payments_client ON payments(client_id, created_at DESC);
```

### Step 1.2: Apply Row-Level Security (PostgreSQL)

```sql
-- Enable RLS on all client-sensitive tables
ALTER TABLE check_ins ENABLE ROW LEVEL SECURITY;
ALTER TABLE packages ENABLE ROW LEVEL SECURITY;
ALTER TABLE sessions ENABLE ROW LEVEL SECURITY;
ALTER TABLE payments ENABLE ROW LEVEL SECURITY;

-- Clients can only see their own data
CREATE POLICY client_check_ins_policy ON check_ins
  FOR SELECT
  USING (client_id IN (SELECT id FROM clients WHERE user_id = current_setting('app.user_id')::uuid));

CREATE POLICY client_packages_policy ON packages
  FOR SELECT
  USING (client_id IN (SELECT id FROM clients WHERE user_id = current_setting('app.user_id')::uuid));

-- Coaches can see all their clients' data
CREATE POLICY coach_check_ins_policy ON check_ins
  FOR ALL
  USING (client_id IN (
    SELECT c.id FROM clients c
    JOIN coaches co ON co.id = c.coach_id
    WHERE co.user_id = current_setting('app.user_id')::uuid
  ));

CREATE POLICY coach_packages_policy ON packages
  FOR ALL
  USING (client_id IN (
    SELECT c.id FROM clients c
    JOIN coaches co ON co.id = c.coach_id
    WHERE co.user_id = current_setting('app.user_id')::uuid
  ));
```

